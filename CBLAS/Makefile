# adStack for reverse mode (like BLAS Makefile)
$(BUILD_DIR)/adStack.o: | $(BUILD_DIR)
	@if [ -f $(SRC_DIR)/adStack.c ]; then \
		$(CC) $(CFLAGS) -I$(SRC_DIR) -c $(SRC_DIR)/adStack.c -o $@; \
	elif [ -n "$$TAPENADEDIR" ] && [ -f "$$TAPENADEDIR/ADFirstAidKit/adStack.c" ]; then \
		$(CC) $(CFLAGS) -I$$TAPENADEDIR/ADFirstAidKit -c $$TAPENADEDIR/ADFirstAidKit/adStack.c -o $@; \
	elif [ -f "$(ADSTACK_DIR)/adStack.c" ]; then \
		$(CC) $(CFLAGS) -I$(ADSTACK_DIR) -c $(ADSTACK_DIR)/adStack.c -o $@; \
	else \
		echo "ERROR: adStack.c not found. Set ADSTACK_DIR or TAPENADEDIR, or pass --adstack-dir to run_tapenade_cblas.py"; \
		exit 1; \
	fi

